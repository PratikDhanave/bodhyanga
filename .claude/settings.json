{
  "permissions": {
    "allow": [
      "Bash(gofmt -l *)",
      "Bash(go env *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose ps *)",
      "Bash(make smoke *)",
      "Bash(make eval *)",
      "Bash(make opa-test *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go build *)",
      "mcp__776c271b-46f9-4b5c-8574-838a053a2c70__search_threads",
      "mcp__776c271b-46f9-4b5c-8574-838a053a2c70__get_thread",
      "mcp__Claude_in_Chrome__find",
      "mcp__Claude_in_Chrome__tabs_context_mcp",
      "mcp__Claude_in_Chrome__get_page_text",
      "mcp__Claude_in_Chrome__read_page",
      "mcp__Claude_in_Chrome__list_connected_browsers",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__read_page",
      "mcp__ccd_session__mark_chapter",
      "mcp__claude_ai_Mermaid_Chart__validate_and_render_mermaid_diagram",
      "mcp__computer-use__screenshot"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/sg-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/security_reminder_hook.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/sg-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/security_reminder_hook.py\""
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/sg-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/security_reminder_hook.py\"",
            "if": "Bash(git commit:*)",
            "asyncRewake": true,
            "rewakeMessage": "Background security review of commit — address or acknowledge the findings below:",
            "rewakeSummary": "Commit security review found issues"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/sg-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/security_reminder_hook.py\"",
            "if": "Bash(git push:*)",
            "asyncRewake": true,
            "rewakeMessage": "Background security review of pushed commits — address or acknowledge the findings below:",
            "rewakeSummary": "Push security review found issues"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/sg-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/security_reminder_hook.py\"",
            "asyncRewake": true,
            "rewakeMessage": "Background security review feedback — address or acknowledge the findings below:",
            "rewakeSummary": "Background security review found issues"
          }
        ]
      }
    ]
  }
}
