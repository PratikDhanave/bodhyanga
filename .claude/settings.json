{
  "permissions": {
    "allow": [
      "Bash(gofmt -l *)",
      "Bash(go env *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose ps *)",
      "Bash(make smoke *)",
      "Bash(make eval *)",
      "Bash(make opa-test *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/sg-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/security_reminder_hook.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/sg-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/security_reminder_hook.py\""
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/sg-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/security_reminder_hook.py\"",
            "if": "Bash(git commit:*)",
            "asyncRewake": true,
            "rewakeMessage": "Background security review of commit — address or acknowledge the findings below:",
            "rewakeSummary": "Commit security review found issues"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/sg-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/security_reminder_hook.py\"",
            "if": "Bash(git push:*)",
            "asyncRewake": true,
            "rewakeMessage": "Background security review of pushed commits — address or acknowledge the findings below:",
            "rewakeSummary": "Push security review found issues"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/sg-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/plugins/security-guidance/hooks/security_reminder_hook.py\"",
            "asyncRewake": true,
            "rewakeMessage": "Background security review feedback — address or acknowledge the findings below:",
            "rewakeSummary": "Background security review found issues"
          }
        ]
      }
    ]
  }
}
