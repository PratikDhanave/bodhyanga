# EditorConfig — consistent formatting across editors
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Go files — tabs (gofmt standard)
[*.go]
indent_style = tab

# YAML — 2 spaces (Kubernetes, Helm, GitHub Actions)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON — 2 spaces
[*.json]
indent_style = space
indent_size = 2

# TypeScript / JavaScript / TSX / JSX — 2 spaces (React convention)
[*.{ts,tsx,js,jsx,css}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# Makefile — tabs required
[Makefile]
indent_style = tab

# Rego policies — 2 spaces (OPA convention)
[*.rego]
indent_style = space
indent_size = 2

# SQL migrations — 2 spaces
[*.sql]
indent_style = space
indent_size = 2

# Helm templates
[*.tpl]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# TOML
[*.toml]
indent_style = space
indent_size = 2
