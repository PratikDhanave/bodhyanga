# Bodh environment variables (research / demo use).
#
# Copy to .env (gitignored) and source before running:
#   set -a; . ./.env; set +a
#
# These keys are only required when the diagnostician runs in LLM mode.
# All other commands and flows work without them.

# --- LLM diagnostician: Anthropic ---
# Required for `-diagnostician=llm-anthropic`.
# Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6 if unset.
# BODH_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- LLM diagnostician: OpenAI ---
# Required for `-diagnostician=llm-openai`.
# Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o if unset.
# BODH_OPENAI_MODEL=gpt-4o

# --- LLM diagnostician: Ollama (local) ---
# No API key required. Used with `-diagnostician=llm-ollama`.
# Make sure the model is pulled first: `ollama pull llama3.2`.

# Optional. Defaults to http://localhost:11434 if unset.
# OLLAMA_HOST=http://localhost:11434

# Optional. Defaults to llama3.2 if unset. Examples: mistral, qwen2.5:14b, llama3.2:3b.
# BODH_OLLAMA_MODEL=llama3.2

# --- Observability: Laminar (lmnr.ai) ---
# Required for `go build -tags otel` with Laminar export.
# Get a key at https://www.lmnr.ai → Settings → API Keys.
LMNR_PROJECT_API_KEY=

# Optional. Defaults to https://api.lmnr.ai (cloud). Override for self-hosted.
# LMNR_BASE_URL=http://localhost:8000

# Optional. OTel service.name label in Laminar traces. Defaults to "bodh".
# BODH_SERVICE_NAME=bodh
