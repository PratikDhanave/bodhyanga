# bodhyanga-maf (maf/) environment variables — research / demo use.
#
# Copy to maf/.env (gitignored) and source before running:
#   set -a; . ./maf/.env; set +a
# Or set them inline: `make maf-care DIAGNOSTICIAN=llm-anthropic`.
#
# Every LLM key is optional: the default `-diagnostician=rule` engine and all
# tests run without any of them.

# --- LLM diagnostician: Anthropic ---
# Required for `-diagnostician=llm-anthropic`. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6 if unset.
# BODHYANGA_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- LLM diagnostician: Ollama (local) ---
# No API key. Used with `-diagnostician=llm-ollama`; pull the model first.
# Optional. Defaults to http://localhost:11434 if unset.
# OLLAMA_HOST=http://localhost:11434
# Optional. Defaults to llama3.2 if unset.
# BODHYANGA_OLLAMA_MODEL=llama3.2
# Optional. Embedding model for RAG. Defaults to nomic-embed-text.
# BODHYANGA_OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Durable checkpoints (cmd/care -db, cmd/slice -db) ---
# Postgres URL enabling paused physician reviews to survive a restart.
# Also read as the `-db` flag default.
SLICE_DB=

# --- Checkpoint encryption at rest (optional) ---
# 64 hex chars = 32-byte AES-256 key. When set, cmd/care seals checkpoint
# payloads before they hit Postgres (see pkg/ckptpg.NewAESGCM). Unset = rely on
# database-level encryption at rest. Generate one with:
#   openssl rand -hex 32
CKPT_ENC_KEY=
