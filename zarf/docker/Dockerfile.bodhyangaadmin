#
# PLACEHOLDER — the bodhyangaadmin / kronk binary is queued behind Track B and
# does not yet exist in cmd/. This Dockerfile is here so the compose
# `bodhyanga-kronk` service has a buildable target the moment the binary lands.
#
# When ready: drop the `-tags=kronk` (or whatever the kronk build tag turns
# out to be), and uncomment the `bodhyanga-kronk` service in
# zarf/compose/docker_compose.yaml.
#
# Until then this build will fail with "no Go files in /service/cmd/bodhyangaadmin"
# — that failure is intentional and informative.

FROM golang:1.26-alpine AS build_bodhyangaadmin
ENV CGO_ENABLED=0
ARG BUILD_TAG=dev
# Default build tag wires in the future kronk surface. Caller can override.
ARG GO_BUILD_TAGS="kronk"

WORKDIR /service

COPY go.mod go.sum ./
RUN go mod download

COPY . .

WORKDIR /service/cmd/bodhyangaadmin
RUN go build \
      -trimpath \
      -tags "${GO_BUILD_TAGS}" \
      -ldflags "-s -w -X main.tag=${BUILD_TAG}" \
      -o /out/bodhyangaadmin .

FROM gcr.io/distroless/static-debian12:nonroot
ARG BUILD_DATE
ARG BUILD_TAG=dev

COPY --from=build_bodhyangaadmin --chown=65532:65532 /out/bodhyangaadmin /bodhyangaadmin

USER 65532:65532
ENTRYPOINT ["/bodhyangaadmin"]

LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="bodhyanga-bodhyangaadmin" \
      org.opencontainers.image.description="Bodhyanga admin / kronk operator tool (PLACEHOLDER)" \
      org.opencontainers.image.authors="Pratik Dhanave" \
      org.opencontainers.image.source="https://github.com/PratikDhanave/bodhyanga" \
      org.opencontainers.image.revision="${BUILD_TAG}" \
      org.opencontainers.image.licenses="Apache-2.0"
