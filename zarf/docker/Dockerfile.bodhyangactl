# syntax=docker/dockerfile:1.7
#
# Adapted from https://github.com/ardanlabs/service/blob/master/zarf/docker/dockerfile.sales
# Original copyright Ardan Labs (Apache 2.0). Modifications for Bodhyanga.
#
# bodhyangactl — operator CLI. Stdlib-only Go binary. Targets a running cmd/care
# API; useful as a one-shot container in a CI job or a kubectl exec target.

FROM golang:1.26-alpine AS build_bodhyangactl
ENV CGO_ENABLED=0
ARG BUILD_TAG=dev
WORKDIR /service

COPY go.mod go.sum ./
RUN go mod download

COPY . .

WORKDIR /service/cmd/bodhyangactl
RUN go build \
      -trimpath \
      -ldflags "-s -w -X main.tag=${BUILD_TAG}" \
      -o /out/bodhyangactl .

FROM gcr.io/distroless/static-debian12:nonroot
ARG BUILD_DATE
ARG BUILD_TAG=dev

COPY --from=build_bodhyangactl --chown=65532:65532 /out/bodhyangactl /bodhyangactl

USER 65532:65532
ENTRYPOINT ["/bodhyangactl"]

LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="bodhyanga-bodhyangactl" \
      org.opencontainers.image.description="Bodhyanga operator CLI" \
      org.opencontainers.image.authors="Pratik Dhanave" \
      org.opencontainers.image.source="https://github.com/PratikDhanave/bodhyanga" \
      org.opencontainers.image.revision="${BUILD_TAG}" \
      org.opencontainers.image.licenses="Apache-2.0"
